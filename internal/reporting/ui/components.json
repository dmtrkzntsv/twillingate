    {
      "name": "area",
      "description": "A trend over time or category, filled under the line; use `stacked` to show parts of a whole changing over time.",
      "accepts": [
        "sql"
      ],
      "inputs": {
        "open": false,
        "columns": [
          {
            "name": "x",
            "types": [
              "day",
              "text"
            ]
          },
          {
            "name": "y",
            "types": [
              "number"
            ]
          },
          {
            "name": "series",
            "types": [
              "text"
            ],
            "optional": true
          }
        ]
      },
      "props": {
        "type": "object",
        "properties": {
          "format": {
            "enum": [
              "number",
              "percent",
              "duration"
            ]
          },
          "curve": {
            "enum": [
              "linear",
              "monotone",
              "step"
            ]
          },
          "stacked": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "default_width": 6,
      "default_height": 8
    },
