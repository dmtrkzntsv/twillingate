{"query":{"kind":"breakdown","table":"events","dimensions":["group_id","group_label","group_first_seen"],"order":"Actions","limit":100,"where":[{"column":"family","op":"in","values":["views","product"]},{"column":"group_id","op":"is_set"}],"metrics":[{"op":"count","as":"Actions"},{"op":"daily_max","of":"users","as":"Peak daily users"},{"op":"days","as":"Active days"},{"op":"max","column":"day","as":"Last seen"}]},"rename":{"group_label":"Group","group_first_seen":"First seen"},"columns":["Group","Actions","Peak daily users","Active days","First seen","Last seen"]}
