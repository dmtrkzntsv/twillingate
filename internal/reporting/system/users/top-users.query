{"query":{"kind":"breakdown","table":"events","dimensions":["user_id","user_label","user_first_seen"],"order":"Actions","limit":100,"where":[{"column":"family","op":"in","values":["views","product"]},{"column":"user_id","op":"is_set"}],"metrics":[{"op":"count","as":"Actions"},{"op":"count","as":"Events","where":[{"column":"family","op":"eq","values":["product"]}]},{"op":"count","as":"Views","where":[{"column":"family","op":"eq","values":["views"]}]},{"op":"days","as":"Active days"},{"op":"max","column":"day","as":"Last seen"}]},"rename":{"user_label":"User","user_first_seen":"First seen"},"columns":["User","Actions","Events","Views","Active days","First seen","Last seen"]}
