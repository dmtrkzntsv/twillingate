    "sql": "WITH g AS (SELECT \"country\", count(*) FILTER (WHERE \"event_name\" = 'landing')::DOUBLE / NULLIF(count(DISTINCT \"actor_id\"), 0) AS r FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-08-02' AND DATE '2026-09-10' GROUP BY 1),\n\t\t\t\ttop AS (SELECT \"country\" FROM g ORDER BY r DESC NULLS LAST, \"country\" ASC NULLS LAST LIMIT 2)\n\t\t\t\tSELECT \"day\", v.\"country\", count(*) FILTER (WHERE \"event_name\" = 'landing')::DOUBLE / NULLIF(count(DISTINCT \"actor_id\"), 0) FROM views v JOIN top ON top.\"country\" IS NOT DISTINCT FROM v.\"country\"\n\t\t\t\t\tWHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-08-02' AND DATE '2026-09-10' GROUP BY ALL ORDER BY \"day\", v.\"country\" ASC NULLS LAST"
  }
