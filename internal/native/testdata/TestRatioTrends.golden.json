    "sql": "WITH w AS (SELECT \"day\" AS x, count(*) FILTER (WHERE \"event_name\" = 'landing')::DOUBLE / NULLIF(count(DISTINCT \"actor_id\"), 0) AS y FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-07-28' AND DATE '2026-09-10' GROUP BY 1),\n\t\t\t\td AS (SELECT CAST(range AS DATE) AS x FROM range(DATE '2026-07-28', DATE '2026-09-10' + INTERVAL 1 DAY, INTERVAL 1 DAY))\n\t\t\t\tSELECT d.x, w.y FROM d LEFT JOIN w USING (x) ORDER BY 1"
