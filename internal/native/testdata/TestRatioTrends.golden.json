    "sql": "SELECT x, series, y FROM (\n\t\t\t\tSELECT \"day\" AS x, 'views' AS series, 0 AS k, count(*)::DOUBLE AS y FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-08-02' AND DATE '2026-09-10' GROUP BY 1\n\t\t\t\tUNION ALL SELECT \"day\", 'per_visitor', 1, count(*) FILTER (WHERE \"event_name\" = 'landing')::DOUBLE / NULLIF(count(DISTINCT \"actor_id\"), 0) FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-08-02' AND DATE '2026-09-10' GROUP BY 1\n\t\t\t) ORDER BY x, k"
  },
