    "rules": "{Events:[{ProjectID:1 Family:views Name:ev_old Action:rename To:landing CreatedAt:} {ProjectID:1 Family:product Name:ev1 Action:rename To:signup CreatedAt:} {ProjectID:1 Family:product Name:ev3 Action:block To: CreatedAt:} {ProjectID:2 Family:views Name:pageview Action:block To: CreatedAt:}] Attributes:[{ProjectID:1 Key:colour Action:rename To:color CreatedAt:}]}",
    "sql": "WITH w AS (SELECT x, series, y FROM (\n\t\tSELECT \"day\" AS x, 'all' AS series, 0 AS k, count(*) AS y FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-07-28' AND DATE '2026-09-10' GROUP BY 1\n\t\tUNION ALL SELECT \"day\", 'early', 1, count(*) FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-07-28' AND DATE '2026-09-10' AND \"day\" <= DATE '2026-08-10' GROUP BY 1\n\t\tUNION ALL SELECT \"day\", 'early_width', 2, avg(\"display_width\") FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-07-28' AND DATE '2026-09-10' AND \"day\" <= DATE '2026-08-10' GROUP BY 1\n\t\tUNION ALL SELECT \"day\", 'early_peak', 3, count(DISTINCT \"actor_id\") FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-07-28' AND DATE '2026-09-10' AND \"day\" <= DATE '2026-08-10' GROUP BY 1\n\t) ORDER BY x, k),\n\t\td AS (SELECT CAST(range AS DATE) AS x FROM range(DATE '2026-07-28', DATE '2026-09-10' + INTERVAL 1 DAY, INTERVAL 1 DAY)),\n\t\ts AS (SELECT * FROM (VALUES ('all', 0, true), ('early', 1, true), ('early_width', 2, false), ('early_peak', 3, true)) v(series, k, counted))\n\t\tSELECT d.x, s.series, CASE WHEN s.counted THEN COALESCE(w.y, 0) ELSE w.y END\n\t\tFROM d CROSS JOIN s LEFT JOIN w ON w.x = d.x AND w.series = s.series ORDER BY d.x, s.k"
  },
