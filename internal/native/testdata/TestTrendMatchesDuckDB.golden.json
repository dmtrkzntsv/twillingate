    "sql": "WITH g AS (SELECT \"country\", count(*) AS c FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-07-28' AND DATE '2026-09-10' AND \"event_name\" = 'landing' GROUP BY 1),\n\t\ttop AS (SELECT \"country\" FROM g ORDER BY c DESC, \"country\" ASC NULLS LAST LIMIT 2),\n\t\td AS (SELECT CAST(range AS DATE) AS x FROM range(DATE '2026-07-28', DATE '2026-09-10' + INTERVAL 1 DAY, INTERVAL 1 DAY)),\n\t\tv AS (SELECT \"day\", \"country\", count(*) AS c FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-07-28' AND DATE '2026-09-10' AND \"event_name\" = 'landing' GROUP BY ALL)\n\t\tSELECT d.x, top.\"country\", COALESCE(v.c, 0) FROM d CROSS JOIN top\n\t\tLEFT JOIN v ON v.\"day\" = d.x AND v.\"country\" IS NOT DISTINCT FROM top.\"country\"\n\t\tORDER BY d.x, top.\"country\" ASC NULLS LAST"
  },
