    "sql": "WITH w AS (-- Visitors are distinct per day and kind, added up over a day's kinds.\nWITH daily AS (\n  SELECT day, kind, count(DISTINCT actor_id) AS visitors, count(*) AS views\n  FROM views\n  WHERE project_id = 1 AND day BETWEEN DATE '2026-07-28' AND DATE '2026-09-10'\n  GROUP BY day, kind\n),\ntotals AS (\n  SELECT day, SUM(visitors) AS visitors, SUM(views) AS views\n  FROM daily\n  GROUP BY day\n)\nSELECT day AS x, 'Visitors' AS series, visitors AS y FROM totals\nUNION ALL\nSELECT day, 'Views', views FROM totals\nORDER BY x, series\n),\n\t\td AS (SELECT CAST(range AS DATE) AS x FROM range(DATE '2026-07-28', DATE '2026-09-10' + INTERVAL 1 DAY, INTERVAL 1 DAY)),\n\t\ts AS (SELECT * FROM (VALUES ('Views', 0, true), ('Visitors', 1, true)) v(series, k, counted))\n\t\tSELECT d.x, s.series, CASE WHEN s.counted THEN COALESCE(w.y, 0) ELSE w.y END\n\t\tFROM d CROSS JOIN s LEFT JOIN w ON w.x = d.x AND w.series = s.series ORDER BY d.x, s.k"
  }
