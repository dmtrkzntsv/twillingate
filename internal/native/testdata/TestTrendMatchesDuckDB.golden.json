    "sql": "WITH w AS (-- A user's first day is the first event the files hold for it (identities):\n-- \"new\" means new to that history, so a user returning after it has aged out\n-- counts as new.\nWITH daily AS (\n  SELECT e.day,\n         count(DISTINCT e.user_id) FILTER (WHERE e.day = i.first_seen::DATE) AS new_count,\n         count(DISTINCT e.user_id) FILTER (WHERE e.day > i.first_seen::DATE) AS returning_count\n  FROM events e\n  JOIN identities i ON i.project_id = 4 AND i.kind = 'user' AND i.id = e.user_id\n  WHERE e.project_id = 4 AND e.family IN ('views', 'product') AND e.user_id <> ''\n    AND e.day BETWEEN DATE '2026-08-20' AND DATE '2026-09-10'\n  GROUP BY e.day\n)\nSELECT day AS x, 'New users' AS series, new_count AS y FROM daily\nUNION ALL\nSELECT day, 'Returning users', returning_count FROM daily\nORDER BY x, series\n),\n\t\td AS (SELECT CAST(range AS DATE) AS x FROM range(DATE '2026-08-20', DATE '2026-09-10' + INTERVAL 1 DAY, INTERVAL 1 DAY)),\n\t\ts AS (SELECT * FROM (VALUES ('New users', 0, true), ('Returning users', 1, true)) v(series, k, counted))\n\t\tSELECT d.x, s.series, CASE WHEN s.counted THEN COALESCE(w.y, 0) ELSE w.y END\n\t\tFROM d CROSS JOIN s LEFT JOIN w ON w.x = d.x AND w.series = s.series ORDER BY d.x, s.k"
  },
