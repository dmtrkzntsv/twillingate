    "sql": "SELECT x, series, y FROM (\n\t\tSELECT \"day\" AS x, 'all' AS series, 0 AS k, count(*) AS y FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-08-02' AND DATE '2026-09-10' GROUP BY 1\n\t\tUNION ALL SELECT \"day\", 'early', 1, count(*) FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-08-02' AND DATE '2026-09-10' AND \"day\" <= DATE '2026-08-10' GROUP BY 1\n\t\tUNION ALL SELECT \"day\", 'early_width', 2, avg(\"display_width\") FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-08-02' AND DATE '2026-09-10' AND \"day\" <= DATE '2026-08-10' GROUP BY 1\n\t\tUNION ALL SELECT \"day\", 'early_peak', 3, count(DISTINCT \"actor_id\") FROM views WHERE \"project_id\" = 1 AND \"day\" BETWEEN DATE '2026-08-02' AND DATE '2026-09-10' AND \"day\" <= DATE '2026-08-10' GROUP BY 1\n\t) ORDER BY x, k"
