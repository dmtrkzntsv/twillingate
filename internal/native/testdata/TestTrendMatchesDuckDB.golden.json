    "sql": "-- Visitors are distinct per day and kind, added up over a day's kinds.\nWITH daily AS (\n  SELECT day, kind, count(DISTINCT actor_id) AS visitors, count(*) AS views\n  FROM views\n  WHERE project_id = 1 AND day BETWEEN DATE '2026-08-02' AND DATE '2026-09-10'\n  GROUP BY day, kind\n),\ntotals AS (\n  SELECT day, SUM(visitors) AS visitors, SUM(views) AS views\n  FROM daily\n  GROUP BY day\n)\nSELECT day AS x, 'Visitors' AS series, visitors AS y FROM totals\nUNION ALL\nSELECT day, 'Views', views FROM totals\nORDER BY x, series\n"
  },
