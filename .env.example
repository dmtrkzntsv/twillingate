# Infra settings for the analytics collector. install.sh copies this to
# /etc/twillingate/twillingate.env, where both systemd units load it
# (EnvironmentFile=); docker compose reads it as `.env` (env_file:). The
# binary itself reads plain environment variables.
# Commented lines show the built-in defaults.

DATABASE_DSN=sqlite:///var/lib/twillingate/twillingate.db
# Project configuration lives in the database. Create projects with
# `twillingate project create` (or an MCP management tool); migrate an old
# projects.json once with `twillingate config import`.
#INGEST_ADDR=127.0.0.1:8080
# Public base URL of the collector (script.js and /ingest/events live there).
# Embed snippets and MCP integration guidance are built from it.
#PUBLIC_URL=https://twillingate.example.com
#GEO_DSN=cloudflare://

#LOG_LEVEL=info
#LOG_FORMAT=json
#LOG_FILE=

#BUFFER_FLUSH_MAX_EVENTS=1000
#BUFFER_FLUSH_INTERVAL=5s
#BUFFER_CAPACITY=10000

#RETENTION_EVENTS_RAW_DAYS=30
#RETENTION_EVENTS_AGGREGATE_DAYS=365

# Distinct client-supplied values kept per declared product attribute
# (agg_product_attrs rows); the rest collapse into "(other)". The operator
# picks the key via each project's `attributes` list; this caps the values.
#PRODUCT_ATTRIBUTES_TOP_N=50

# API surface (serve -api): MCP at /mcp and REST at /api/. Authentication is
# one DSN; no default — unset, bare `serve` skips the API with a warning. One of:
#   API_AUTH_DSN=token://<token>                  (mint with `twillingate keygen -api`)
#   API_AUTH_DSN='token://<token>?password=<pw>'  (browser login for claude.ai, ChatGPT, Desktop, Codex; see docs/deployment.md)
#   API_AUTH_DSN=oauth://idp.example.com          (resource defaults to API_URL)
#API_AUTH_DSN=
#API_ADDR=
# The API's public origin when it has its own hostname; defaults to PUBLIC_URL.
# The login, and the dashboards at /app/, work on it with no redirect= entry.
#API_URL=https://api.example.com
#API_DB_PATH=
#API_QUERY_TIMEOUT=10s
#API_QUERY_MAX_ROWS=1000

# Dashboard widget cache (/app/ and widget_data). An ordinary load reuses a
# widget's result up to REPORTING_CACHE_SECONDS old (0 turns the cache off); a
# manual refresh (fresh=true) reuses one up to REPORTING_REFRESH_SECONDS old,
# which must not exceed the cache age. A dashboard with auto-refresh on reloads
# every max(REPORTING_CACHE_SECONDS, REPORTING_REFRESH_SECONDS) seconds while
# its window has focus.
#REPORTING_CACHE_SECONDS=900
#REPORTING_REFRESH_SECONDS=60
