# Infra settings for the analytics collector under ship. `ship install
# twillingate` copies this to /etc/<service>/twillingate.env only when that
# file is absent; the unit (deploy/ship/twillingate.service) and `ship run
# twillingate -- <command>` both load it. Same settings as .env.example,
# install.sh's copy, except where noted. Commented lines show the built-in
# defaults.

# Relative to the working directory, which is the service's data directory
# (/var/lib/<service>) both in the unit and under `ship run`, so this file
# holds no service name. Keep DATA_DIR unset: twillingate-sql, in the same
# service, reads the event files at data/ in that directory.
DATABASE_DSN=sqlite://twillingate.db
# Project configuration lives in the database. Create projects with
# `twillingate project create` (or an MCP management tool); migrate an old
# projects.json once with `twillingate config import`.
#INGEST_ADDR=127.0.0.1:8080
# Public base URL of the collector (script.js and /ingest/events live there).
# Embed snippets and MCP integration guidance are built from it.
#INGEST_URL=https://twillingate.example.com
#GEO_DSN=cloudflare://

#LOG_LEVEL=info
#LOG_FORMAT=json
#LOG_FILE=

#BUFFER_FLUSH_MAX_EVENTS=1000
#BUFFER_FLUSH_INTERVAL=5s
#BUFFER_CAPACITY=10000

#INGEST_LATE_DAYS=1
#RETENTION_DAYS=400
#DATA_DIR=data
#RETENTION_FORMS_DRAFT_DAYS=7
#RETENTION_ARCHIVED_DAYS=30
# The external SQL engine's socket. The unit sets it to twillingate-sql's,
# sql-engine.sock in the service's runtime directory (/run/<service>);
# uncomment this empty line to turn SQL off when that engine is not
# installed.
#SQL_ENGINE_SOCKET=

# Console surface (serve -console): MCP at /mcp, REST at /api/, the login and
# the dashboards at /app/. Authentication is one DSN; no default — unset, bare
# `serve` skips the console with a warning. One of:
#   CONSOLE_AUTH_DSN=token://<token>                  (mint with `twillingate keygen -console`)
#   CONSOLE_AUTH_DSN='token://<token>?password=<pw>'  (browser login for claude.ai, ChatGPT, Desktop, Codex; see docs/deployment.md)
#   CONSOLE_AUTH_DSN=oauth://idp.example.com          (resource defaults to CONSOLE_URL)
#CONSOLE_AUTH_DSN=
#CONSOLE_ADDR=
# The console's public origin when it has its own hostname; defaults to INGEST_URL.
# The login, and the dashboards at /app/, work on it with no redirect= entry.
#CONSOLE_URL=https://console.example.com
#CONSOLE_DATABASE_DSN=
#CONSOLE_QUERY_TIMEOUT=30s
#CONSOLE_QUERY_ROWS_MAX=1000

# Dashboard widget cache (/app/ and widget_data). An ordinary load reuses a
# widget's result up to REPORTING_CACHE_MAX_AGE old (0 turns the cache off); a
# manual refresh (fresh=true) reuses one up to REPORTING_REFRESH_MAX_AGE old,
# which must not exceed the cache age. A dashboard with auto-refresh on reloads
# every max(REPORTING_CACHE_MAX_AGE, REPORTING_REFRESH_MAX_AGE) while its
# window has focus.
#REPORTING_CACHE_MAX_AGE=15m
#REPORTING_REFRESH_MAX_AGE=1m

# Seconds between the availability checks of each enabled monitor (10 to 3600).
#MONITOR_INTERVAL=120

# Seconds a site has to answer a check before it counts as down (1 to 60,
# below MONITOR_INTERVAL).
#MONITOR_TIMEOUT=5

# How many checks count as one event on this install's plan; Settings then shows
# what a monitor costs a month. 0 (the default) shows nothing.
#MONITOR_CHECKS_PER_EVENT=0

# true stops all monitoring: no check runs and no row is written. Monitors can
# still be edited; a check on demand is refused.
#MONITOR_DISABLED=false
